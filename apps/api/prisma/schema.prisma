generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentProvider {
  MERCADOPAGO
  MOCK
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String
  benefits       String[]
  priceCents     Int
  promoPriceCents Int?
  stock          Int             @default(0)
  isActive       Boolean         @default(true)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label           String
  weightGrams     Int?
  type            String?
  quantity        Int?
  priceDeltaCents Int      @default(0)
  stock           Int      @default(0)
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique
  status        OrderStatus @default(PENDING_PAYMENT)

  customerName  String
  email         String
  cpf           String
  phone         String

  address       OrderAddress?
  items         OrderItem[]
  payment       Payment?

  subtotalCents Int
  shippingCents Int
  discountCents Int
  totalCents    Int

  shippingServiceName String?
  shippingDeadlineDays Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderAddress {
  id           String @id @default(cuid())
  orderId      String @unique
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  zip          String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  variantId      String?
  nameSnapshot   String
  variantSnapshot String?
  unitPriceCents Int
  quantity       Int
  totalCents     Int
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String          @unique
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)
  providerPaymentId String?
  payload           Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model SiteSettings {
  id                    Int     @id @default(1)
  storeName             String  @default("Tempero Gourmet")
  logoUrl               String?
  primaryColor          String  @default("#0B0B0B")
  backgroundColor       String  @default("#FFFFFF")
  accentColor           String  @default("#6B4F3A")
  whatsapp              String?
  contactEmail          String?

  pixDiscountPercent    Int     @default(5)
  freeShippingEnabled   Boolean @default(false)
  freeShippingMinSubtotalCents Int @default(0)
  shippingMarginPercent Int     @default(0)

  home                  Json?
  testimonials          Json?

  melhorEnvioTokenEnc   String?
  melhorEnvioFromZip    String?

  mercadoPagoAccessTokenEnc String?
  mercadoPagoPublicKeyEnc   String?
}
